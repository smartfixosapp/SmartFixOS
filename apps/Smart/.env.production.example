# ================================================================
# SmartFixOS — Production Environment Variables
# Copy this to .env and fill in the values.
# VITE_ vars go to Vercel → Environment Variables (build-time)
# Non-VITE_ vars go to Render → Environment Variables (runtime)
# ================================================================

# ── Supabase (both Vercel & Render need these) ─────────────────
VITE_SUPABASE_URL=https://idntuvtabecwubzswpwi.supabase.co
VITE_SUPABASE_ANON_KEY=<from Supabase dashboard → API → anon key>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard → API → service_role key>
# NUNCA como VITE_SUPABASE_SERVICE_ROLE_KEY — cualquier var VITE_ se incrusta
# en el bundle público del navegador. El panel GACC/SuperAdmin ya no la
# necesita en el cliente; ver apps/Smart/src/Functions/gaccDataProxy.js.

# ── GACC / SuperAdmin panel (Render only) ───────────────────────
SUPER_ADMIN_EMAIL=<email autorizado a recibir el OTP del panel>
ADMIN_SECRET_PIN=<PIN secreto largo y aleatorio — jamás en código ni en git>

# ── Frontend → Vercel ──────────────────────────────────────────
VITE_FUNCTION_URL=https://smartfixos-api.onrender.com   # Render URL
VITE_API_URL=https://smartfixos-api.onrender.com
VITE_APP_URL=https://your-app.vercel.app
VITE_APP_NAME=SmartFixOS
VITE_DB_SCHEMA=public

# ── Deno Server → Render ───────────────────────────────────────
FUNCTIONS_PORT=8686          # Render overrides with PORT env var automatically
DB_SCHEMA=public
DB_BACKEND=supabase_cloud
FN_TRIGGER_CRON_INTERVAL=120 # seconds between cron runs
RUN_MIGRATIONS=false

# ── Email (Render only) ────────────────────────────────────────
RESEND_API_KEY=<from resend.com dashboard>
FROM_EMAIL=noreply@archillaos.com
FROM_NAME=SmartFixOS

# ── Security (Render only — Render can auto-generate) ──────────
CRON_SECRET=<random string, protects /runScheduledFnTriggers>

# ── Optional AI (Render only) ─────────────────────────────────
# GEMINI_API_KEY — de Google AI Studio (aistudio.google.com/apikey), capa
# gratis. La usan Finanzas: resumen ejecutivo (geminiSummary.js),
# categorización de gastos (geminiCategorizeExpense.js) y escaneo de
# recibos/facturas por visión (aiExtractExpense.js). SIN prefijo VITE_ —
# nunca debe llegar al navegador.
GEMINI_API_KEY=<your gemini key — aistudio.google.com/apikey, free tier>
OPENAI_API_KEY=<your openai key if using AI features — ya no lo usa Finanzas>

# ── Stripe (frontend → Vercel) ─────────────────────────────────
# Publishable key — pk_test_* en staging, pk_live_* en producción.
# Setear en Vercel → Project Settings → Environment Variables (build-time).
VITE_STRIPE_PUBLISHABLE_KEY=<from Stripe Dashboard → Developers → API keys>

# ── Stripe (server-side · Supabase Edge Functions) ──────────────
# NUNCA va en frontend. Setear como secret en Supabase:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...    (cuando Memo cree el webhook)
